# SME24 environment. Copy to .env.local for local work (`supabase start` prints the local URL and keys).
# Values live in Vercel (Development, Preview, Production scopes; pull with `vercel env pull .env.local`)
# and in Trigger.dev per environment. "deployed" below means Vercel Preview/Production and Trigger.dev
# staging/prod; locally those keys may stay empty and the integration logs a warning instead.

# --- Supabase (required, browser and server clients) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: Trigger.dev and server only admin code. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- App ---
# Absolute URLs in emails, sitemap and Stripe redirects (required).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Trigger.dev (required) ---
# Runtime key per environment: the staging key in Vercel Preview, the prod key in Production.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
# TRIGGER_ACCESS_TOKEN is a GitHub repo secret for the deploy job, not an app variable.

# --- AI (required when deployed, used from feature 8 on) ---
AI_GATEWAY_API_KEY=

# --- Sentry (required when deployed, EU region DSN) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Build time only (CI and Vercel build) for source map upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- PostHog EU (required when deployed; the server uses the same project key) ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Optional until their feature lands ---
PARALLEL_API_KEY=                  # optional (feature 8)
STRIPE_SECRET_KEY=                 # optional (feature 11)
STRIPE_WEBHOOK_SECRET=             # optional (feature 11)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY= # optional (feature 11)

# --- Email and ops alerts (feature 7, spec 0006; docs/email.md has the per environment checklist) ---
# Trigger.dev variables (the send-email and ops-alert tasks read them):
RESEND_API_KEY=                    # hosted only, a send only key per environment; unset locally so SMTP is used
EMAIL_FROM=                        # required when deployed: "SME24 <no-reply@<verified domain>>"; locally falls back to SME24 <no-reply@sme24.local>
EMAIL_REPLY_TO=                    # optional, the ops mailbox replies go to
EMAIL_SMTP_URL=smtp://127.0.0.1:54325   # local only: the Mailpit SMTP port (smtp_port in supabase/config.toml)
EMAIL_ALLOWED_RECIPIENTS=          # optional: comma separated addresses or @domain entries; set on staging, unset on production
OPS_ALERT_WEBHOOK_URL=             # optional: the Slack incoming webhook of the environment's channel (Trigger.dev, mirrored in Vercel)
# Vercel variable (the /api/webhooks/resend route reads it):
RESEND_WEBHOOK_SECRET=             # the signing secret of the Resend webhook endpoint; the webhook answers 503 until it is set
# Local shell only: set to 1 while `pnpm trigger:dev` runs so the Playwright welcome test asserts on the email.
TRIGGER_DEV_RUNNING=

# --- GitHub repo secrets (not app variables) ---
# STAGING_SUPABASE_DB_URL, PROD_SUPABASE_DB_URL  -> migrate job
# TRIGGER_ACCESS_TOKEN                            -> tasks job
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT   -> source maps
# VERCEL_AUTOMATION_BYPASS_SECRET                 -> e2e job, Vercel "Protection Bypass for Automation"

# --- Local end to end tests only ---
# Password of the seeded users (supabase/seed.sql). Set it to run the role gate e2e test.
E2E_SEED_PASSWORD=
