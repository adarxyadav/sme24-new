{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.claude",
      "!.next",
      "!supabase/templates",
      "!work",
      "!dist",
      "!build",
      "!.trigger",
      "!playwright-report",
      "!test-results",
      "!src/lib/supabase/database.types.ts",
      "!next-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "preset": "recommended"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/app/**",
        "src/components/**",
        "src/features/**/ui/**",
        "src/lib/analytics/client.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/lib/supabase/service": "The service client bypasses RLS. Use it only from src/trigger and server only code in src/features/*/actions.ts."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**",
        "src/features/**/ui/**",
        "src/lib/analytics/client.tsx",
        "src/lib/supabase/client.ts",
        "src/instrumentation-client.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@/lib/supabase/service": "The service client bypasses RLS. Use it only from src/trigger and server only code in src/features/*/actions.ts.",
                  "@/lib/env": "zod must not reach the browser; read public variables through @/lib/env.public",
                  "@/lib/analytics/catalogue": {
                    "allowImportNames": ["AnalyticsProperties"],
                    "message": "zod must not reach the browser: catalogue.ts imports zod and this module is in the root layout, so a value import puts the zod runtime in every marketing first load (spec 0009, AC-16). Event names come from @/lib/analytics/events; only the AnalyticsProperties type may come from here, and only as `import type`."
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/sidebar.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noDocumentCookie": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/chart.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          },
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/field.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noArrayIndexKey": "off"
          },
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["src/components/ui/breadcrumb.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useFocusableInteractive": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["src/app/globals.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
