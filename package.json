{
  "name": "sme24",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "[ -n \"$CI\" ] || lefthook install",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db schema declarative sync --no-apply --name",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "user:invite": "node scripts/invite-user.mts",
    "trigger:dev": "trigger.dev dev --env-file .env.local",
    "trigger:deploy:staging": "trigger.dev deploy --env staging",
    "trigger:deploy:prod": "trigger.dev deploy --env prod"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@sentry/nextjs": "^10.73.0",
    "@sentry/node": "^10.73.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "@trigger.dev/sdk": "^4.5.15",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.2.5",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.38.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.422.5",
    "posthog-node": "^5.51.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "2.5.11",
    "@playwright/test": "^1.62.1",
    "@sentry/esbuild-plugin": "^5.4.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@trigger.dev/build": "^4.5.15",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "culori": "^4.0.2",
    "dotenv": "^17.4.2",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "supabase": "^2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": "22.x",
    "pnpm": ">=10"
  }
}
